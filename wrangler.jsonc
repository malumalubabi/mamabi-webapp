{
  // Tells Cloudflare's build system this is a Pages project (static assets
  // at "." + Functions auto-picked up from /functions) - without this,
  // Cloudflare's newer unified "wrangler deploy" defaults to expecting a
  // plain Worker entry-point and fails with "Missing entry-point to Worker
  // script or to assets directory".
  "name": "mamabi-webapp",
  "compatibility_date": "2025-07-18",
  "pages_build_output_dir": "."
}
